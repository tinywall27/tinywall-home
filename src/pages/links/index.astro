---
import { isExternalUrl, siteHref } from '../../lib/urls';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { linkGroups } from '../../data/links';
import { getCommandItems } from '../../lib/content';

const commandItems = await getCommandItems();
const populatedGroups = linkGroups.filter((group) => group.links.length > 0);
const totalLinks = populatedGroups.reduce((total, group) => total + group.links.length, 0);
---

<BaseLayout
	title="Links｜TinyWall"
	description="TinyWall 日常使用的金融、研究、协作与开发网址导航。"
	commandItems={commandItems}
>
	<div class="page-shell">
		<header class="page-heading">
			<p class="eyebrow">LINKS</p>
			<h1>把高频入口留在手边。</h1>
			<p>一份经过筛选的个人网址导航，按实际用途组织，而不是继续堆积浏览器书签。</p>
		</header>

		<div class="section-stack">
			<section aria-labelledby="links-title">
				<header class="section-header">
					<h2 id="links-title">网址目录</h2>
					<p class="meta">{totalLinks} 个入口</p>
				</header>
				{populatedGroups.length > 0 ? (
					<div class="link-directory" data-pagefind-ignore>
						{populatedGroups.map((group) => (
							<section class="link-group" aria-labelledby={`link-group-${group.id}`}>
								<h3 id={`link-group-${group.id}`}>{group.label}</h3>
								<p>{group.description}</p>
								<ul>
									{group.links.map((link) => (
										<li>
											<a href={siteHref(link.url)} target={isExternalUrl(link.url) ? "_blank" : undefined} rel={isExternalUrl(link.url) ? "noopener noreferrer" : undefined}>
												<span>
													<strong>{link.title}</strong>
													{link.description && <small>{link.description}</small>}
												</span>
												<span aria-hidden="true">{isExternalUrl(link.url) ? '↗' : '→'}</span>
												{isExternalUrl(link.url) && <span class="visually-hidden">（在新标签页打开）</span>}
											</a>
										</li>
									))}
								</ul>
							</section>
						))}
					</div>
				) : (
					<div class="empty-state panel">
						<h3>网址导航暂时为空</h3>
						<p>常用入口会在核对用途和链接后加入。</p>
					</div>
				)}
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.link-group > p {
		min-height: 2.6em;
		margin: -0.35rem 0 0.8rem;
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	.link-group h3 {
		margin-bottom: 0.75rem;
		font-family: var(--sans);
		font-size: 1rem;
		letter-spacing: -0.01em;
	}

	.link-group a > span:first-child {
		display: grid;
		gap: 0.12rem;
	}

	.link-group small {
		color: var(--text-muted);
		font-size: 0.75rem;
		font-weight: 400;
	}

	@media (max-width: 820px) {
		.link-group > p {
			min-height: 0;
		}
	}
</style>
