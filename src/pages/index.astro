---
import { isExternalUrl, siteHref } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import ReadingRow from '../components/ReadingRow.astro';
import { projectStatuses } from '../data/projects';
import { topicMap } from '../data/topics';
import { formatDate, formatShortDate, getCommandItems, getTodayContent } from '../lib/content';

const [today, commandItems] = await Promise.all([getTodayContent(), getCommandItems()]);
const generatedAt = new Date();
const intelligenceGroups = Object.entries(
	today.intelligence.reduce<Record<string, typeof today.intelligence>>((groups, reading) => {
		const primaryTopic = reading.data.topics[0];
		(groups[primaryTopic] ??= []).push(reading);
		return groups;
	}, {}),
);
---

<BaseLayout
	title="Today｜TinyWall"
	description="TinyWall 的今日信息入口：精选阅读、常用链接、个人项目与近期笔记。"
	commandItems={commandItems}
>
	<div class="page-shell">
		<header class="today-header">
			<p class="eyebrow today-date">
				<time datetime={generatedAt.toISOString()} data-today-date>{formatDate(generatedAt)}</time>
				<span aria-hidden="true">·</span>
				<span>Today</span>
			</p>
			<h1>今天，先看真正值得关注的内容。</h1>
			<p>从一份可信的阅读线索开始，再回到项目、工具与正在积累的想法。</p>
		</header>

		<div class="section-stack">
			<section aria-labelledby="intelligence-title">
				<header class="section-header">
					<div>
						<p class="eyebrow">TODAY INTELLIGENCE</p>
						<h2 id="intelligence-title">值得关注</h2>
					</div>
					{today.asOf && (
						<p class="meta">
							<span>内容截至</span>
							<time datetime={today.asOf.toISOString()}>{formatShortDate(today.asOf)}</time>
						</p>
					)}
				</header>
				{intelligenceGroups.length > 0 ? (
					<div class="intelligence-groups">
						{intelligenceGroups.map(([topic, readings]) => (
							<section class="intelligence-group" aria-labelledby={`intelligence-${topic}`}>
								<h3 id={`intelligence-${topic}`}>{topicMap[topic as keyof typeof topicMap].name}</h3>
								<div class="intelligence-list">
									{readings.map((reading) => <ReadingRow reading={reading} showReason={false} />)}
								</div>
							</section>
						))}
					</div>
				) : (
					<div class="empty-state panel">
						<h3>今天暂时没有更多资讯</h3>
						<p>高质量内容不足时不凑数，可以先查看下面的 Daily Read 或完整 Reading。</p>
						<a href="/reading/">前往 Reading <span aria-hidden="true">→</span></a>
					</div>
				)}
			</section>

			<section class="today-grid" aria-label="每日阅读与快捷入口">
				<div class="daily-feature">
					<header class="section-header">
						<div>
							<p class="eyebrow">DAILY READ</p>
							<h2>今天值得细读</h2>
						</div>
						<a href="/reading/">全部阅读 <span aria-hidden="true">→</span></a>
					</header>
					{today.dailyRead ? (
						<article class="daily-feature__entry" data-pagefind-ignore>
							<div class="meta">
								<span>{today.dailyRead.data.source}</span>
								<time datetime={today.dailyRead.data.curatedAt.toISOString()}>
									收录于 {formatShortDate(today.dailyRead.data.curatedAt)}
								</time>
								{today.dailyRead.data.readingMinutes && <span>约 {today.dailyRead.data.readingMinutes} 分钟</span>}
							</div>
							<h3>
								<a href={today.dailyRead.data.url} target="_blank" rel="noopener noreferrer">
									{today.dailyRead.data.title}<span class="visually-hidden">（在新标签页打开原文）</span>
								</a>
							</h3>
							<p>{today.dailyRead.data.summary}</p>
							<p class="daily-feature__reason"><strong>为什么值得读：</strong>{today.dailyRead.data.reason}</p>
							<div class="filter-chips">
								{today.dailyRead.data.topics.map((topic) => (
									<a href={`/topics/${topic}/`}>{topicMap[topic].name}</a>
								))}
							</div>
						</article>
					) : (
						<div class="empty-state">
							<h3>还没有今日精选</h3>
							<p>下一条经过来源核验的阅读会出现在这里。</p>
						</div>
					)}
				</div>

				<aside class="quick-links" aria-labelledby="quick-links-title">
					<header class="section-header">
						<div>
							<p class="eyebrow">QUICK LINKS</p>
							<h2 id="quick-links-title">常用入口</h2>
						</div>
						<a href="/links/">全部 <span aria-hidden="true">→</span></a>
					</header>
					{today.quickLinks.length > 0 ? (
						<ul>
							{today.quickLinks.map((link) => (
								<li>
									<a href={siteHref(link.url)} target={isExternalUrl(link.url) ? "_blank" : undefined} rel={isExternalUrl(link.url) ? "noopener noreferrer" : undefined}>
										<span>{link.title}</span>
										<span aria-hidden="true">{isExternalUrl(link.url) ? '↗' : '→'}</span>
										{isExternalUrl(link.url) && <span class="visually-hidden">（在新标签页打开）</span>}
									</a>
								</li>
							))}
						</ul>
					) : (
						<p class="empty-state">暂时没有高频链接。</p>
					)}
				</aside>
			</section>

			<section aria-labelledby="projects-title">
				<header class="section-header">
					<div>
						<p class="eyebrow">PROJECTS</p>
						<h2 id="projects-title">正在做的项目</h2>
					</div>
					<a href="/projects/">全部项目 <span aria-hidden="true">→</span></a>
				</header>
				{today.projects.length > 0 ? (
					<div class="project-list" data-pagefind-ignore>
						{today.projects.map((project) => (
							<article class="project-item">
								<div class="project-item__copy">
									<div class="project-item__meta">
										<span>{projectStatuses[project.status]}</span>
										<span>{project.tags.join(' · ')}</span>
									</div>
									<h3 class="project-item__title">
										<a
											href={siteHref(project.url ?? `/projects/#${project.id}`)}
											target={isExternalUrl(project.url) ? '_blank' : undefined}
											rel={isExternalUrl(project.url) ? 'noopener noreferrer' : undefined}
										>
											{project.title}{isExternalUrl(project.url) && <span class="visually-hidden">（在新标签页打开）</span>}
										</a>
									</h3>
									<p class="project-item__description">{project.description}</p>
								</div>
								<a
									class="external-mark"
									href={siteHref(project.url ?? `/projects/#${project.id}`)}
									target={isExternalUrl(project.url) ? '_blank' : undefined}
									rel={isExternalUrl(project.url) ? 'noopener noreferrer' : undefined}
									aria-label={`${project.url ? '打开' : '查看'}项目：${project.title}`}
								>
									<span aria-hidden="true">{isExternalUrl(project.url) ? '↗' : '→'}</span>
								</a>
							</article>
						))}
					</div>
				) : <p class="empty-state panel">项目列表暂时为空。</p>}
			</section>

			<section aria-labelledby="notes-title">
				<header class="section-header">
					<div>
						<p class="eyebrow">RECENT NOTES</p>
						<h2 id="notes-title">最近笔记</h2>
					</div>
					<a href="/notes/">全部笔记 <span aria-hidden="true">→</span></a>
				</header>
				{today.recentNotes.length > 0 ? (
					<div class="content-list" data-pagefind-ignore>
						{today.recentNotes.map((note) => (
							<article class="item-row content-row">
								<div class="content-row__copy">
									<div class="meta">
										<time datetime={(note.data.updatedAt ?? note.data.publishedAt).toISOString()}>
											{formatShortDate(note.data.updatedAt ?? note.data.publishedAt)}
										</time>
										{note.data.updatedAt && <span>已更新</span>}
									</div>
									<h3 class="content-row__title"><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
									{note.data.description && <p class="content-row__description">{note.data.description}</p>}
								</div>
								<a class="content-row__external" href={`/notes/${note.id}/`} aria-label={`阅读笔记：${note.data.title}`}>
									<span aria-hidden="true">→</span>
								</a>
							</article>
						))}
					</div>
				) : <p class="empty-state panel">还没有公开笔记。</p>}
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.today-date {
		display: flex;
		gap: 0.55rem;
		align-items: center;
	}

	.section-header > .meta {
		margin: 0;
	}

	.daily-feature__entry {
		display: grid;
		gap: 0.9rem;
	}

	.daily-feature__entry h3 {
		margin: 0;
		font-size: clamp(1.4rem, 3vw, 2.3rem);
		line-height: 1.18;
	}

	.daily-feature__entry h3 a {
		text-decoration: none;
	}

	.daily-feature__entry > p {
		margin: 0;
		color: var(--text-muted);
	}

	.daily-feature__reason {
		padding-left: 0.85rem;
		border-left: 2px solid var(--accent);
		font-size: 0.88rem;
	}

	.daily-feature__reason strong {
		color: var(--text);
	}

	.quick-links a {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.intelligence-groups {
		display: grid;
		gap: 1.5rem;
	}

	.intelligence-group h3 {
		margin: 0 0 0.35rem;
		color: var(--accent-strong);
		font-family: var(--sans);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}

	.empty-state h3 {
		margin-bottom: 0.5rem;
	}

	.empty-state p {
		margin-bottom: 0.85rem;
		color: var(--text-muted);
	}
</style>
