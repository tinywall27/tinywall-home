---
import ContentRow from '../../components/ContentRow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCommandItems, getDatedContentItems } from '../../lib/content';

const [items, commandItems] = await Promise.all([getDatedContentItems(), getCommandItems()]);
const years = [...new Set(items.map((item) => String(item.date.getFullYear())))];
const yearGroups = years.map((year) => ({
	year,
	items: items.filter((item) => String(item.date.getFullYear()) === year),
}));
---

<BaseLayout
	title="Archive｜TinyWall"
	description="按年份回看 TinyWall 的文章、笔记与外部精选阅读。"
	commandItems={commandItems}
>
	<div class="page-shell">
		<header class="page-heading">
			<p class="eyebrow">ARCHIVE</p>
			<h1>时间是一条回到思考现场的路径。</h1>
			<p>归档按日期聚合 Articles、Notes 与 Reading，同时保留各自原本的内容身份。</p>
		</header>

		<div class="section-stack archive-v1">
			{yearGroups.length > 0 ? yearGroups.map(({ year, items: yearItems }) => (
				<section aria-labelledby={`archive-${year}`}>
					<header class="section-header">
						<h2 id={`archive-${year}`}><a href={`/archive/${year}/`}>{year}</a></h2>
						<p class="meta">{yearItems.length} 条内容</p>
					</header>
					<div class="content-list">
						{yearItems.map((item) => <ContentRow item={item} showDescription={false} />)}
					</div>
				</section>
			)) : (
				<div class="empty-state panel">
					<h2>归档暂时为空</h2>
					<p>第一条公开内容发布后，会按年份自动归入这里。</p>
				</div>
			)}
		</div>
	</div>
</BaseLayout>
