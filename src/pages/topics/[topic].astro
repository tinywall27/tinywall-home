---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentRow from '../../components/ContentRow.astro';
import { topics } from '../../data/topics';
import { getCommandItems, getDatedContentItems, type DatedContentItem } from '../../lib/content';

export async function getStaticPaths() {
	const items = await getDatedContentItems();
	return topics.map((topic) => ({
		params: { topic: topic.id },
		props: {
			topic,
			items: items.filter((item) => item.topics.includes(topic.id)),
		},
	}));
}

interface Props {
	topic: (typeof topics)[number];
	items: DatedContentItem[];
}

const { topic, items } = Astro.props as Props;
const commandItems = await getCommandItems();
const typeCounts = {
	article: items.filter((item) => item.type === 'article').length,
	note: items.filter((item) => item.type === 'note').length,
	reading: items.filter((item) => item.type === 'reading').length,
};
---

<BaseLayout title={`${topic.name}｜TinyWall`} description={topic.description} commandItems={commandItems}>
	<div class="page-shell">
		<header class="page-heading">
			<a class="back-link" href="/topics/">← 全部主题</a>
			<p class="eyebrow">TOPIC / {topic.id.toUpperCase()}</p>
			<h1>{topic.name}</h1>
			<p>{topic.description}</p>
			<div class="meta topic-summary">
				<span>{items.length} 条内容</span>
				<span>{typeCounts.article} 文章</span>
				<span>{typeCounts.note} 笔记</span>
				<span>{typeCounts.reading} 外部阅读</span>
			</div>
		</header>

		<div class="section-stack">
			<section aria-labelledby="topic-content-title">
				<header class="section-header">
					<h2 id="topic-content-title">最新内容</h2>
					<p class="meta">按日期从新到旧</p>
				</header>
				{items.length > 0 ? (
					<div class="content-list">
						{items.map((item) => <ContentRow item={item} />)}
					</div>
				) : (
					<div class="empty-state panel">
						<h3>这个主题还没有公开内容</h3>
						<p>文章、笔记或外部阅读发布后会自动出现在这里。</p>
						<a href="/reading/">返回 Reading <span aria-hidden="true">→</span></a>
					</div>
				)}
			</section>
		</div>
	</div>
</BaseLayout>

<style>
	.topic-summary {
		margin-top: 1.15rem;
	}
</style>
