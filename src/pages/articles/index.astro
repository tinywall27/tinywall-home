---
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topics } from '../../data/topics';
import { getArticleYear } from '../../lib/articles';
import { getCommandItems, getPublishedArticles } from '../../lib/content';

const [articles, commandItems] = await Promise.all([getPublishedArticles(), getCommandItems()]);
const years = [...new Set(articles.map(getArticleYear))];
---

<BaseLayout
	title="Articles｜TinyWall"
	description="搜索、筛选并阅读 TinyWall 的长文与 AI Daily Brief。"
	commandItems={commandItems}
>
	<div class="page-shell">
		<header class="page-heading">
			<p class="eyebrow">ARTICLES</p>
			<h1>完整文章与编辑简报。</h1>
			<p>这里保存 TinyWall 自写的长文；外部文章与报告请前往 Reading。</p>
		</header>

		<div class="section-stack">
			<section class="article-browser" id="search" aria-labelledby="search-title">
				<form class="filter-bar" id="article-filters" role="search">
					<div class="search-field">
						<label for="article-search" id="search-title">搜索文章</label>
						<input
							id="article-search"
							name="q"
							type="search"
							placeholder="搜索标题、正文或主题…"
							autocomplete="off"
						/>
					</div>
					<div class="select-field">
						<label for="topic-filter">主题</label>
						<select id="topic-filter" name="topic">
							<option value="">全部主题</option>
							{topics.map((topic) => <option value={topic.id}>{topic.name}</option>)}
						</select>
					</div>
					<div class="select-field">
						<label for="year-filter">年份</label>
						<select id="year-filter" name="year">
							<option value="">全部年份</option>
							{years.map((year) => <option value={year}>{year}</option>)}
						</select>
					</div>
					<button class="filter-reset" type="reset">清除</button>
				</form>

				<header class="section-header results-heading" aria-live="polite">
					<h2><strong data-result-count>{articles.length}</strong> 篇文章</h2>
					<span class="meta">按发布时间从新到旧</span>
				</header>

				<div class="content-list" data-article-list>
					{articles.map((article) => <ArticleCard article={article} searchable />)}
				</div>
				<div class="empty-state panel" data-empty-state hidden>
					<h2>没有找到匹配的文章</h2>
					<p>试试缩短关键词，或者清除主题与年份筛选。</p>
				</div>
			</section>
		</div>
	</div>
</BaseLayout>

<script is:inline type="module" src="/article-search.js"></script>

<style>
	.results-heading {
		margin-top: 1.5rem;
	}

	.results-heading h2 {
		font-size: 1rem;
	}
</style>
