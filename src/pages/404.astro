---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCommandItems } from '../lib/content';

const commandItems = await getCommandItems();
---

<BaseLayout
	title="页面未找到｜TinyWall"
	description="你访问的 TinyWall 页面不存在。"
	commandItems={commandItems}
>
	<div class="page-shell">
		<section class="not-found panel empty-state" aria-labelledby="not-found-title">
			<p class="not-found__number" aria-hidden="true">404</p>
			<div>
				<p class="eyebrow">PAGE NOT FOUND</p>
				<h1 id="not-found-title">这面墙上，还没有这一页。</h1>
				<p>地址可能已经变化，也可能只是一次暂时的迷路。可以返回 Today，或打开搜索找到其他内容。</p>
				<div class="not-found__actions">
					<a class="button button--primary" href="/">返回 Today</a>
					<button class="button" type="button" data-command-open>搜索 TinyWall</button>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.not-found {
		margin-block: clamp(3rem, 9vw, 7rem);
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
		margin-top: 1.25rem;
	}
</style>
