---
import { secondaryNavigation } from '../data/navigation';
import { siteMetadata } from '../data/site';

const isExternal = (href: string) => href.startsWith('http://') || href.startsWith('https://');
---

<footer class="site-footer" data-pagefind-ignore>
	<div class="shell site-footer__inner">
		<div class="site-footer__about">
			<a class="brand brand--footer" href="/">{siteMetadata.name}</a>
			<p>把每天值得关注的信息、长期思考与常用入口放在一起。</p>
		</div>
		<nav class="footer-nav" aria-label="次级导航">
			{secondaryNavigation.map((item) => (
				<a
					href={item.href}
					target={isExternal(item.href) ? '_blank' : undefined}
					rel={isExternal(item.href) ? 'noopener noreferrer' : undefined}
				>
					{item.label}{isExternal(item.href) && <span aria-hidden="true"> ↗</span>}
				</a>
			))}
		</nav>
		<div class="site-footer__meta">
			<span>© {new Date().getFullYear()} {siteMetadata.name}</span>
			<span>静态构建 · 可切换外观</span>
		</div>
	</div>
</footer>
