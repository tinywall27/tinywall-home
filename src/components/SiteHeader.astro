---
import { primaryNavigation } from '../data/navigation';

const pathname = Astro.url.pathname;
const readingRoutes = ['/reading/', '/articles/', '/topics/', '/archive/'];
const isActive = (href: string) => {
	if (href === '/') return pathname === '/';
	if (href === '/projects/' && pathname.startsWith('/guides/')) return true;
	if (href === '/reading/') return readingRoutes.some((route) => pathname.startsWith(route));
	return pathname.startsWith(href);
};
---

<header class="site-header" data-pagefind-ignore>
	<div class="site-header__inner shell">
		<a class="brand" href="/" aria-label="TinyWall Today">
			<span class="brand__mark" aria-hidden="true">T</span>
			<span class="brand__name">TinyWall</span>
		</a>

		<nav class="primary-nav" aria-label="主导航">
			<ul>
				{primaryNavigation.map((item) => (
					<li>
						<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="site-header__tools">
			<button
				class="system-mode"
				type="button"
				data-theme-toggle
				aria-label="切换外观模式"
			>
				<span class="system-mode__dot" aria-hidden="true"></span>
				<span data-theme-label>系统</span>
			</button>
			<button class="command-trigger" type="button" data-command-open aria-haspopup="dialog">
				<span class="command-trigger__label">搜索</span>
				<kbd aria-label="快捷键 Command 或 Control 加 K">⌘ K</kbd>
			</button>

			<details class="site-menu" data-site-menu>
				<summary>
					<span>菜单</span>
					<span class="menu-icon" aria-hidden="true"></span>
				</summary>
				<div class="site-menu__panel">
					<nav aria-label="移动端主导航">
						<ul>
							{primaryNavigation.map((item) => (
								<li>
									<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
										<span>{item.label}</span><span aria-hidden="true">→</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
					<div class="site-menu__footer">
						<button type="button" data-command-open aria-haspopup="dialog">
							搜索 TinyWall <span aria-hidden="true">⌘ K</span>
						</button>
						<button type="button" data-theme-toggle aria-label="切换外观模式">
							<span>外观模式</span><span data-theme-label>系统</span>
						</button>
					</div>
				</div>
			</details>
		</div>
	</div>
</header>
